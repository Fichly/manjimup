# URL publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://manjimup.fr

# --- Acheminement des leads (tous optionnels ; sans config → log serveur) ---

# Resend : email à chaque lead
# RESEND_API_KEY=re_xxx
# LEADS_TO_EMAIL=bonjour@manjimup.fr
# LEADS_FROM_EMAIL="MANJIM'UP <site@manjimup.fr>"

# Brevo : création/mise à jour d'un contact
# BREVO_API_KEY=xkeysib-xxx
# BREVO_LIST_ID=3

# Webhook générique (HubSpot, Supabase Edge Function, Make, n8n, Zapier…)
# LEAD_WEBHOOK_URL=https://hook.example.com/manjimup-leads
